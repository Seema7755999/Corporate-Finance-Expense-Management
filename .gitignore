# Python byte-code, packaging and build leftovers
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg

# Private Python environments
.venv/
venv/
env/
ENV/

# Secrets (the safe template stays tracked)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Run-time data: the folders stay (through .gitkeep), their contents never do
chroma_db/*
!chroma_db/.gitkeep
uploaded_documents/*
!uploaded_documents/.gitkeep
.cache/

# Test, lint and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs, notebooks, editors, tools and operating-system files
*.log
.ipynb_checkpoints/
.vscode/
.idea/
.kilo/
.DS_Store
Thumbs.db

# Working files of the build (kept on disk, never published)
/plan.md
/progress.md
/MASTER_PROMPT_FOR_CLAUDE.md

# Course-provided files (not part of the deliverable)
/capstone_project.pdf
/Additional instruction.txt

# Loose working copies of the sample files in the project root.
# The files that ship live in sample_documents/.
/Corporate_Expense_Policy.pdf
/Q3_Audit_Memo.txt
/Q4_Financial_Budget.xlsx
/Travel_Expense_Claims.csv
/Travel_Expense_Claims.xls
