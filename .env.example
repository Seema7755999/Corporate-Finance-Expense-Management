# LedgerLens settings. Make a copy of this file called ".env" and put your own keys in the copy.
#   Windows:    copy .env.example .env
#   Mac/Linux:  cp .env.example .env
# Never share your .env file and never upload it to GitHub.

# Main language model: Google Gemini. Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional. If this is empty, missing or an old retired name, the app uses gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
# Optional. A second Gemini model on the same key. It is tried last, when the main one is overloaded.
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite

# Spare language model: Groq (used automatically when Gemini fails). Free key: https://console.groq.com/keys
# Optional but recommended: the app also works with only one of the two keys.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Optional. A second Groq model on the same key. It is tried when the main Groq model fails.
GROQ_BACKUP_MODEL=openai/gpt-oss-20b

# Optional. A free Gemini key allows only a few requests per day for each model. If you run out,
# remove the # in front of the next line to ask Groq first (this needs GROQ_API_KEY). Default: gemini.
# PRIMARY_LLM=groq
